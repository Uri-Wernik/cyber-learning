{
  "schema_version": 8,
  "scope": "workspace",
  "default_mode": "clean_editorial",
  "notebook_requires_explicit_request": true,
  "title_alignment": "page_center",
  "pagination": {
    "flow": "continuous",
    "force_one_section_per_page": false,
    "keep_section_heading_with_first_paragraph": true,
    "keep_new_term_with_definition_card": true,
    "break_only_for_measured_fit": true,
    "content_bottom_margin_pt": 54,
    "continuation_baseline_pt": 68,
    "section_gap_pt": 24,
    "record_unused_tail_and_break_reason": true,
    "reject_stretching_art_to_hide_whitespace": true
  },
  "illustrations": {
    "placement": "near_the_explained_concept",
    "allowed_regions": ["between_paragraphs_full_width", "main_column_with_side_notes", "end_of_section_when_useful"],
    "shape": "fit_the_explanation",
    "background": "#FFF8EB",
    "background_required": true,
    "box_required": true,
    "background_exception_requires_explicit_request": true,
    "panel_padding_required": true,
    "sequential_figure_numbers": false,
    "text_reference_required": false,
    "numbered_text_references": false,
    "figure_number_labels": false,
    "explanation_target_required": true,
    "detail_policy": "functional_components_and_mechanisms_not_decoration",
    "required_on_every_page": false,
    "fixed_bottom_position": false,
    "recompose_for_new_aspect_ratio": true,
    "preserve_reading_order": true
  },
  "page_extras": {
    "automatic_figure_captions": false,
    "standalone_takeaway_slogans": false,
    "footer_source_labels": false,
    "empty_links": false,
    "references_location": "separate_support_file",
    "accessible_descriptions_location": "text_alternative_or_support_file",
    "preserve_required_attributions": true
  },
  "main_title": {
    "placement": "lesson_or_chapter_opening_only",
    "preferred_lines": 1,
    "maximum_lines": 2,
    "wrap_only_if_measured_width_exceeds_available": true,
    "repeat_on_continuation_pages": false,
    "font_size_pt": 31
  },
  "definition_cards": {
    "required_for_every_term": true,
    "highlighted_terms_require_card": true,
    "allowed_presentations": ["card"],
    "side_definitions_require_card": true,
    "explicitly_requested_cards_required": true,
    "green_background_required": false,
    "placement": "side_rail",
    "first_occurrence_only": true,
    "connectors": false,
    "gap_pt": 10,
    "horizontal_padding_pt": 12,
    "title_baseline_offset_pt": 18,
    "body_baseline_offset_pt": 34,
    "body_size_pt": 9.7,
    "body_leading_pt": 13.3,
    "bottom_padding_pt": 12
  },
  "a4_layout": {
    "page_size_pt": [595.28, 841.89],
    "margin_left_pt": 42,
    "margin_right_pt": 42,
    "main_width_pt": 300,
    "rail_x_pt": 370,
    "rail_width_pt": 183.28,
    "body_size_pt": 11.15,
    "body_leading_pt": 18.2,
    "paragraph_gap_pt": 14,
    "full_width_clearance_pt": 12,
    "maximum_full_width_reflow_shift_pt": 8,
    "reading_to_figure_gap_pt": 20,
    "maximum_reading_to_figure_gap_pt": 24,
    "maximum_column_bottom_difference_in_lines": 2,
    "caption_gap_pt": 17,
    "caption_to_takeaway_gap_pt": 24
  },
  "palette": {
    "paper": "#FFFEF9",
    "ink": "#263B35",
    "secondary": "#52645C",
    "accent": "#286957",
    "highlight": "#FFE8A0",
    "card": "#EDF3E8"
  },
  "rules": [
    "Use real measured block bounds rather than fixed empty vertical reserves.",
    "Preserve all teaching text and definitions while reflowing.",
    "Review major column-height mismatches; do not shrink fonts to pass.",
    "Do not fill gaps with decorative or repeated content.",
    "Keep richer illustrations explanatory, original and clearly labelled.",
    "Only this workspace uses these preferences; do not modify the personal skill."
  ]
}
